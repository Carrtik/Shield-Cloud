# Circuit breakers
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30

# Async workers
CELERY_WORKER_CONCURRENCY=4
JOB_RESULT_TTL_SECONDS=3600
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Rate limiting
RATE_LIMIT_AUTH_RPM=5
RATE_LIMIT_FILES_RPM=50
RATE_LIMIT_ADMIN_RPM=100

# Event bus
DLQ_ALERT_DEPTH_THRESHOLD=100

# Anomaly detection
ANOMALY_BATCH_WINDOW_MS=200
ANOMALY_BATCH_SIZE=50

# Healing
HEAL_LOCK_TTL_SECONDS=300

# Common Infra
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/shieldcloud
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
